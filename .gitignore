# ==========================================
# 1. LOCAL VIRTUAL ENVIRONMENTS (CRITICAL)
# ==========================================
# This prevents uploading your massive local venv folder to GitHub
venv/
.venv/
env/
ENV/

# ==========================================
# 2. SENSITIVE CREDENTIALS & KEYS (SECURITY)
# ==========================================
# In the future, if you move your Gemini API key to a .env file, 
# this ensures it stays completely hidden and safe.
.env
*.env
secrets.toml
.streamlit/secrets.toml

# ==========================================
# 3. PYTHON CACHE & TEMPORARY FILES
# ==========================================
# Automatically generated Python files that don't belong on GitHub
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==========================================
# 4. OPERATING SYSTEM & WORKSPACE FILES
# ==========================================
# Specific files generated by Windows, Mac, or your IDE
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# IDE configurations (Optional but keeps repo clean)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace